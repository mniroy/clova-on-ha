            };
        };
        d_i2c_pin1 {
            mux {
                groups = "i2c3_sda_a12", "i2c3_sck_a13";
                function = "i2c3";
            };
        };
        d_i2c_pin2 {
            mux {
                groups = "i2c3_sda_a19", "i2c3_sck_a20";
                function = "i2c3";
            };
        };
        spicc_a_pins {
            linux,phandle = <0x1E>;
            phandle = <0x1E>;
            mux {
                groups = "spi0_clk", "spi0_mosi", "spi0_miso", "spi0_ss0";
                function = "spi0";
            };
        };
        spicc_b_pins_A {
            mux {
                groups = "spi1_mosi_a", "spi1_miso_a", "spi1_clk_a", "spi1_ss0_a";
                function = "spi1";
            };
        };
        spicc_b_pins_X {
            linux,phandle = <0x1F>;
            phandle = <0x1F>;
            mux {
                groups = "spi1_mosi_x", "spi1_miso_x", "spi1_clk_x", "spi1_ss0_x";
                function = "spi1";
            };
        };
        nand_pulldown {
            mux {
                groups = "emmc_nand_d0", "emmc_nand_d1", "emmc_nand_d2", "emmc_nand_d3", "emmc_nand_d4", "emmc_nand_d5", "emmc_nand_d6", "emmc_nand_d7", "nand_rb0";
                function = "nand";
                bias-pull-down;
            };
        };
        nand_pullup {
            mux {
                groups = "nand_ce0";
                function = "nand";
                bias-pull-up;
            };
        };
        all_nand_pins {
            linux,phandle = <0x2B>;
            phandle = <0x2B>;
            mux {
                groups = "emmc_nand_d0", "emmc_nand_d1", "emmc_nand_d2", "emmc_nand_d3", "emmc_nand_d4", "emmc_nand_d5", "emmc_nand_d6", "emmc_nand_d7", "nand_ce0", "nand_ale", "nand_cle", "nand_wen_clk", "nand_ren_wr", "nand_rb0";
                function = "nand";
                input-enable;
            };
        };
        nand_cs {
            linux,phandle = <0x2C>;
            phandle = <0x2C>;
            mux {
                groups = "nand_ce0";
                function = "nand";
            };
        };
        emmc_clk_cmd_pins {
            linux,phandle = <0x4A>;
            phandle = <0x4A>;
            mux {
                groups = "emmc_clk", "emmc_cmd";
                function = "emmc";
                input-enable;
                bias-pull-up;
            };
        };
        emmc_conf_pull_up {
            linux,phandle = <0x4B>;
            phandle = <0x4B>;
            mux {
                groups = "emmc_nand_d0", "emmc_nand_d1", "emmc_nand_d2", "emmc_nand_d3", "emmc_nand_d4", "emmc_nand_d5", "emmc_nand_d6", "emmc_nand_d7", "emmc_clk", "emmc_cmd";
                function = "emmc";
                input-enable;
                bias-pull-up;
            };
        };
        emmc_conf_pull_done {
            linux,phandle = <0x4C>;
            phandle = <0x4C>;
            mux {
                groups = "emmc_ds";
                function = "emmc";
                input-enable;
                bias-pull-down;
            };
        };
