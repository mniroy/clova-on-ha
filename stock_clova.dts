/dts-v1/;
// version: 17
// last_comp_version: 16
// boot_cpuid_phys: 0x0

/ {
    model = "Amlogic";
    amlogic-dt-id = "axg_s420_v03";
    compatible = "amlogic, axg";
    interrupt-parent = <0x1>;
    #address-cells = <0x2>;
    #size-cells = <0x2>;
    cpus {
        #address-cells = <0x2>;
        #size-cells = <0x0>;
        cpu-map {
            cluster0 {
                core0 {
                    cpu = <0x2>;
                };
                core1 {
                    cpu = <0x3>;
                };
                core2 {
                    cpu = <0x4>;
                };
                core3 {
                    cpu = <0x5>;
                };
            };
        };
        cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a53", "arm,armv8";
            reg = <0x0 0x0>;
            enable-method = "psci";
            clocks = <0x6 0x0>;
            clock-names = "cpu-cluster.0";
            cpu-idle-states = <0x7>;
            linux,phandle = <0x2>;
            phandle = <0x2>;
        };
        cpu@1 {
            device_type = "cpu";
            compatible = "arm,cortex-a53", "arm,armv8";
            reg = <0x0 0x1>;
            enable-method = "psci";
            clocks = <0x6 0x0>;
            clock-names = "cpu-cluster.0";
            cpu-idle-states = <0x7>;
            linux,phandle = <0x3>;
            phandle = <0x3>;
        };
        cpu@2 {
            device_type = "cpu";
            compatible = "arm,cortex-a53", "arm,armv8";
            reg = <0x0 0x2>;
            enable-method = "psci";
            clocks = <0x6 0x0>;
            clock-names = "cpu-cluster.0";
            cpu-idle-states = <0x7>;
            linux,phandle = <0x4>;
            phandle = <0x4>;
        };
        cpu@3 {
            device_type = "cpu";
            compatible = "arm,cortex-a53", "arm,armv8";
            reg = <0x0 0x3>;
            enable-method = "psci";
            clocks = <0x6 0x0>;
            clock-names = "cpu-cluster.0";
            cpu-idle-states = <0x7>;
            linux,phandle = <0x5>;
            phandle = <0x5>;
        };
        idle-states {
            entry-method = "arm,psci-0.2";
            cpu-sleep-0 {
                compatible = "arm,idle-state";
                arm,psci-suspend-param = <0x10000>;
                local-timer-stop;
                entry-latency-us = <0x1388>;
                exit-latency-us = <0x1388>;
                min-residency-us = <0x3A98>;
                linux,phandle = <0x7>;
                phandle = <0x7>;
            };
        };
    };
    timer {
        compatible = "arm,armv8-timer";
        interrupts = <0x1 0xD 0xFF08 0x1 0xE 0xFF08 0x1 0xB 0xFF08 0x1 0xA 0xFF08>;
    };
    timer_bc {
        compatible = "arm, meson-bc-timer";
        reg = <0x0 0xFFD0F190 0x0 0x4 0x0 0xFFD0F194 0x0 0x4>;
        timer_name = "Meson TimerF";
        clockevent-rating = <0x12C>;
        clockevent-shift = <0x14>;
        clockevent-features = <0x23>;
        interrupts = <0x0 0x3C 0x1>;
        bit_enable = <0x10>;
        bit_mode = <0xC>;
        bit_resolution = <0x0>;
    };
    arm_pmu {
        compatible = "arm,armv8-pmuv3";
        interrupts = <0x0 0x89 0x4 0x0 0x8A 0x4 0x0 0x99 0x4 0x0 0x9A 0x4>;
    };
    interrupt-controller@2c001000 {
        compatible = "arm,cortex-a15-gic", "arm,cortex-a9-gic";
        #interrupt-cells = <0x3>;
        #address-cells = <0x0>;
        interrupt-controller;
        reg = <0x0 0xFFC01000 0x0 0x1000 0x0 0xFFC02000 0x0 0x100>;
        interrupts = <0x1 0x9 0xF04>;
        linux,phandle = <0x1>;
        phandle = <0x1>;
    };
    psci {
        compatible = "arm,psci-0.2";
        method = "smc";
    };
    pm {
        compatible = "amlogic, pm";
        device_name = "aml_pm";
        status = "okay";
        reg = <0x0 0xFF80023C 0x0 0x4>;
    };
    secmon {
        compatible = "amlogic, secmon";
        memory-region = <0x8>;
        in_base_func = <0x82000020>;
        out_base_func = <0x82000021>;
        reserve_mem_size = <0x300000>;
    };
    securitykey {
        compatible = "aml, securitykey";
        storage_query = <0x82000060>;
        storage_read = <0x82000061>;
        storage_write = <0x82000062>;
        storage_tell = <0x82000063>;
        storage_verify = <0x82000064>;
        storage_status = <0x82000065>;
        storage_list = <0x82000067>;
        storage_remove = <0x82000068>;
        storage_in_func = <0x82000023>;
        storage_out_func = <0x82000024>;
        storage_block_func = <0x82000025>;
        storage_size_func = <0x82000027>;
        storage_set_enctype = <0x8200006A>;
        storage_get_enctype = <0x8200006B>;
        storage_version = <0x8200006C>;
    };
    rng {
        compatible = "amlogic,meson-rng";
        status = "okay";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        reg = <0x0 0xFF634018 0x0 0x4>;
    };
    mhu@c883c400 {
        compatible = "amlogic, meson_mhu";
        reg = <0x0 0xFF63C400 0x0 0x4C 0x0 0xFFFD3000 0x0 0x800>;
        interrupts = <0x0 0xD1 0x1 0x0 0xD2 0x1>;
        #mbox-cells = <0x1>;
        mbox-names = "cpu_to_scp_low", "cpu_to_scp_high";
        mboxes = <0x9 0x0 0x9 0x1>;
        linux,phandle = <0x9>;
        phandle = <0x9>;
    };
    scpi_clocks {
        compatible = "arm, scpi-clks";
        scpi_clocks@0 {
            compatible = "arm, scpi-clk-indexed";
            #clock-cells = <0x1>;
            clock-indices = <0x0>;
            clock-output-names = "vcpu";
            linux,phandle = <0x6>;
            phandle = <0x6>;
        };
    };
    cpu_iomap {
        compatible = "amlogic, iomap";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        ranges;
        io_cbus_base {
            reg = <0x0 0xFFD00000 0x0 0x100000>;
        };
        io_apb_base {
            reg = <0x0 0xFFE00000 0x0 0x100000>;
        };
        io_aobus_base {
            reg = <0x0 0xFF800000 0x0 0x100000>;
        };
        io_vapb_base {
            reg = <0x0 0xFF900000 0x0 0x50000>;
        };
        io_hiu_base {
            reg = <0x0 0xFF63C000 0x0 0x10000>;
        };
    };
    xtal-clk {
        compatible = "fixed-clock";
        clock-frequency = <0x16E3600>;
        clock-output-names = "xtal";
        #clock-cells = <0x0>;
        linux,phandle = <0xA>;
        phandle = <0xA>;
    };
    rtc {
        compatible = "amlogic, aml_vrtc";
        alarm_reg_addr = <0xFF8000A8>;
        timer_e_addr = <0xFFD0F188>;
        init_date = "2015/01/01";
        status = "okay";
    };
    cpu_info {
        compatible = "amlogic, cpuinfo";
        status = "okay";
        cpuinfo_cmd = <0x82000044>;
    };
    aml_reboot {
        compatible = "aml, reboot";
        sys_reset = <0x84000009>;
        sys_poweroff = <0x84000008>;
    };
    watchdog@0xffd0f0d0 {
        compatible = "amlogic, meson-wdt";
        status = "disabled";
        default_timeout = <0xA>;
        reset_watchdog_method = <0x1>;
        reset_watchdog_time = <0x2>;
        shutdown_timeout = <0xA>;
        firmware_timeout = <0x6>;
        suspend_timeout = <0x6>;
        reg = <0x0 0xFFD0F0D0 0x0 0x10>;
        clock-names = "xtal";
        clocks = <0xA>;
    };
    pinctrl@ff800014 {
        compatible = "amlogic,meson-axg-aobus-pinctrl";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        ranges;
        ao-bank@ff800014 {
            reg = <0x0 0xFF800014 0x0 0x8 0x0 0xFF80002C 0x0 0x4 0x0 0xFF800024 0x0 0x8>;
            reg-names = "mux", "pull", "gpio";
            gpio-controller;
            #gpio-cells = <0x2>;
            linux,phandle = <0xD>;
            phandle = <0xD>;
        };
        remote_pin {
            linux,phandle = <0x20>;
            phandle = <0x20>;
            mux {
                groups = "remote_input_ao";
                function = "remote_input_ao";
            };
        };
        irblaster_pin {
            linux,phandle = <0x39>;
            phandle = <0x39>;
            mux {
                groups = "remote_out_ao";
                function = "remote_out_ao";
            };
        };
        ao_uart {
            linux,phandle = <0xF>;
            phandle = <0xF>;
            mux {
                groups = "uart_ao_tx_a", "uart_ao_rx_a";
                function = "uart_ao_a";
            };
        };
        ao_b_1_uart {
            linux,phandle = <0x10>;
            phandle = <0x10>;
            mux {
                groups = "uart_ao_tx_b", "uart_ao_rx_b";
                function = "uart_ao_b";
            };
        };
        ao_i2c {
            mux {
                groups = "i2c_ao_sck_4", "i2c_ao_sda_5";
                function = "i2c_ao";
            };
        };
        ao_i2c_pin1 {
            mux {
                groups = "i2c_ao_sck_8", "i2c_ao_sda_9";
                function = "i2c_ao";
            };
        };
        ao_i2c_pin2 {
            linux,phandle = <0xE>;
            phandle = <0xE>;
            mux {
                groups = "i2c_ao_sck_10", "i2c_ao_sda_11";
                function = "i2c_ao";
            };
        };
        s_i2c {
            linux,phandle = <0x25>;
            phandle = <0x25>;
            mux {
                groups = "i2c_ao_slave_sck", "i2c_ao_slave_sda";
                function = "i2c_ao_slave";
            };
        };
        pwm_ao_a_pins {
            linux,phandle = <0x42>;
            phandle = <0x42>;
            mux {
                groups = "pwm_ao_a";
                function = "pwm_ao_a";
            };
        };
        pwm_ao_c_pins {
            linux,phandle = <0x43>;
            phandle = <0x43>;
            mux {
                groups = "pwm_ao_c_ao8";
                function = "pwm_ao_c";
            };
        };
        pwm_ao_d_pins {
            linux,phandle = <0x44>;
            phandle = <0x44>;
            mux {
                groups = "pwm_ao_d";
                function = "pwm_ao_d";
            };
        };
        gpio_ao_9_pins {
            linux,phandle = <0x45>;
            phandle = <0x45>;
            mux {
                groups = "GPIOAO_9";
                function = "gpio_aobus";
                output-high;
            };
        };
        gpio_ao_8_pins {
            linux,phandle = <0x46>;
            phandle = <0x46>;
            mux {
                groups = "GPIOAO_8";
                function = "gpio_aobus";
                output-high;
            };
        };
        gpio_ao_3_pins {
            linux,phandle = <0x47>;
            phandle = <0x47>;
            mux {
                groups = "GPIOAO_3";
                function = "gpio_aobus";
                output-high;
            };
        };
    };
    pinctrl@ff634480 {
        compatible = "amlogic,meson-axg-periphs-pinctrl";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        ranges;
        banks@ff634480 {
            reg = <0x0 0xFF634480 0x0 0x40 0x0 0xFF6344E8 0x0 0x14 0x0 0xFF634520 0x0 0x14 0x0 0xFF634430 0x0 0x3C>;
            reg-names = "mux", "pull", "pull-enable", "gpio";
            gpio-controller;
            #gpio-cells = <0x2>;
            linux,phandle = <0x36>;
            phandle = <0x36>;
        };
        external_eth_pins {
            mux {
                groups = "eth_mdio_y", "eth_mdc_y", "eth_rgmii_rx_clk_y", "eth_rx_dv_y", "eth_rxd0_y", "eth_rxd1_y", "eth_rxd2_rgmii", "eth_rxd3_rgmii", "eth_rgmii_tx_clk", "eth_txen_y", "eth_txd0_y", "eth_txd1_y", "eth_txd2_rgmii", "eth_txd3_rgmii";
                function = "eth";
            };
        };
        ao_b_uart {
            mux {
                groups = "uart_ao_tx_b_z", "uart_ao_rx_b_z";
                function = "uart_ao_b";
            };
        };
        a_uart {
            linux,phandle = <0x37>;
            phandle = <0x37>;
            mux {
                groups = "uart_tx_a", "uart_rx_a", "uart_cts_a", "uart_rts_a";
                function = "uart_a";
            };
        };
        b_uart {
            linux,phandle = <0x38>;
            phandle = <0x38>;
            mux {
                groups = "uart_tx_b_z", "uart_rx_b_z";
