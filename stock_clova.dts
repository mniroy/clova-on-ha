    thermal-zones {
        soc_thermal {
            polling-delay = <0x3E8>;
            polling-delay-passive = <0x64>;
            sustainable-power = <0x41A>;
            thermal-sensors = <0x30 0x3>;
            trips {
                trip-point@0 {
                    temperature = <0x11170>;
                    hysteresis = <0x3E8>;
                    type = "passive";
