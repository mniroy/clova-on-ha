        pdmin {
            linux,phandle = <0x1D>;
            phandle = <0x1D>;
            mux {
                groups = "pdm_dclk_a14", "pdm_din0", "pdm_din1", "pdm_din2", "pdm_din3";
                function = "pdm";
            };
        };
