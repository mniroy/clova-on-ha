    soc {
        compatible = "simple-bus";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        ranges;
        cbus@ffd00000 {
            compatible = "simple-bus";
            reg = <0x0 0xFFD00000 0x0 0x25000>;
            #address-cells = <0x2>;
            #size-cells = <0x2>;
            ranges = <0x0 0x0 0x0 0xFFD00000 0x0 0x25000>;
            interrupt-controller@f080 {
                compatible = "amlogic,meson-gpio-intc", "amlogic,meson-axg-gpio-intc";
                reg = <0x0 0xF080 0x0 0x10>;
                interrupt-controller;
                #interrupt-cells = <0x2>;
                amlogic,channel-interrupts = <0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47>;
                status = "okay";
            };
            meson_clk_msr {
                compatible = "amlogic, gxl_measure";
                reg = <0x0 0x18004 0x0 0x4 0x0 0x1800C 0x0 0x4>;
            };
            i2c@1f000 {
                compatible = "amlogic,meson-axg-i2c";
                status = "disabled";
                reg = <0x0 0x1F000 0x0 0x20>;
