                function = "pwm_c";
            };
        };
        pwm_d_pins {
            mux {
                groups = "pwm_d_x16";
                function = "pwm_d";
            };
        };
        tdmout_a {
            linux,phandle = <0x13>;
            phandle = <0x13>;
            mux {
                groups = "tdma_sclk", "tdma_fs";
                function = "tdma_out";
            };
        };
        tdmout_a_data {
            linux,phandle = <0x14>;
            phandle = <0x14>;
            mux {
                groups = "tdma_dout1_x15";
                function = "tdma_out";
            };
        };
        tdmin_a {
            linux,phandle = <0x12>;
            phandle = <0x12>;
            mux {
                groups = "tdma_din0";
                function = "tdma_in";
            };
        };
        tdmb_mclk {
            linux,phandle = <0x15>;
            phandle = <0x15>;
            mux {
                groups = "mclk_b";
                function = "mclk_b";
            };
        };
        tdmout_b {
            linux,phandle = <0x16>;
            phandle = <0x16>;
            mux {
                groups = "tdmb_sclk", "tdmb_fs", "tdmb_dout0";
                function = "tdmb_out";
            };
        };
        tdmin_b {
            linux,phandle = <0x17>;
            phandle = <0x17>;
            mux {
                groups = "tdmb_din1";
                function = "tdmb_in";
            };
        };
        tdmc_mclk {
            linux,phandle = <0x18>;
            phandle = <0x18>;
            mux {
                groups = "mclk_a";
                function = "mclk_a";
            };
        };
        tdmout_c {
            linux,phandle = <0x19>;
            phandle = <0x19>;
            mux {
                groups = "tdmc_sclk", "tdmc_fs", "tdmc_dout0";
